    "audit:theme": "sh -c 'OUT=$(grep -rEn \"\\b(bg|text|border|ring|shadow|divide|outline)-(zinc|gray|slate|red|green|amber|blue|white|black)(-[0-9]+)?\\b|dark:(bg|text|border|ring)\" ./src/modules ./src/shared --exclude-dir=landing) || true; if [ -n \"$OUT\" ]; then echo \"Theme Audit Report\\nViolations found!\\n\\n$OUT\"; exit 1; else echo \"Theme Audit Report\\nNo violations found.\"; exit 0; fi'"
